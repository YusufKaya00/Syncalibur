# ==============================================================================
# Syncalibur Configuration Template (syncalibur.env.example)
# ==============================================================================
# On first run or `./syncalibur.sh install`, Syncalibur automatically copies this
# file to `syncalibur.env` (which is gitignored so your personal paths, tokens,
# and webhooks are never pushed to the public repository).
#
# Quick setup:
#   ./syncalibur.sh install /path/to/your/repo
# ==============================================================================

# Path to the directory / git repository (or subfolder) to watch:
# - If the folder is not a git repo yet, Syncalibur initializes it automatically.
SYNCALIBUR_REPO_PATH="."

# Enable bidirectional sync (automatically fetches remote & rebases clean changes,
# or safely aborts rebase and opens the diagnostic terminal on merge conflict):
SYNCALIBUR_BIDIRECTIONAL="true"
SYNCALIBUR_PULL_INTERVAL=45

# Generate semantic Conventional Commit messages (`feat(scope): ... (+X/-Y)`):
SYNCALIBUR_SEMANTIC_COMMITS="true"
SYNCALIBUR_COMMIT_STYLE="conventional"
# Enable Smart Staging (splits multi-concern changes into scoped semantic commits):
SYNCALIBUR_SMART_STAGING="true"

# Optional local AI commit message hook via Ollama (`true` / `false`, 2s timeout):
SYNCALIBUR_AI_COMMIT="false"
SYNCALIBUR_OLLAMA_MODEL="qwen2.5-coder:1.5b"

# Automatically watch the Syncalibur installation repository itself:
# - Pushes local improvements you make to Syncalibur's own code
# - Periodically checks upstream for new Syncalibur releases, pulls them,
#   rebuilds the Go engine, and hot-reloads the running background daemon!
SYNCALIBUR_SELF_AUTO_UPDATE="true"
SYNCALIBUR_SELF_CHECK_INTERVAL=120

# Automatically create the remote repository on GitHub/GitLab if it doesn't exist yet (default: false for security):
SYNCALIBUR_AUTO_CREATE_REMOTE="false"
SYNCALIBUR_REPO_VISIBILITY="private"

# Pop open a diagnostic terminal window & status view when a sync or self-update fails:
SYNCALIBUR_ALERT_TERMINAL="true"
SYNCALIBUR_ALERT_COOLDOWN=600

# Optional First-Class Telegram Bot Notifications (sends instant rich HTML cards to your phone/desktop):
# 1. Message @BotFather on Telegram -> /newbot -> copy the Bot Token below
# 2. Message your bot and get your Chat ID (e.g. via @userinfobot or https://api.telegram.org/bot<TOKEN>/getUpdates)
# 3. Test anytime with: syncalibur notify "Hello from Syncalibur!"
SYNCALIBUR_TELEGRAM_BOT_TOKEN=""
SYNCALIBUR_TELEGRAM_CHAT_ID=""

# Optional Webhook URL for instant Discord, Slack, Telegram, or Custom JSON notifications:
# - Discord  : https://discord.com/api/webhooks/<id>/<token>
# - Slack    : https://hooks.slack.com/services/<T>/<B>/<X>
# - Telegram : https://api.telegram.org/bot<TOKEN>/sendMessage?chat_id=<CHAT_ID>
SYNCALIBUR_WEBHOOK_URL=""
SYNCALIBUR_WEBHOOK_EVENTS="failure,recovery,summary"
SYNCALIBUR_WEBHOOK_ON_SUCCESS="false"

# Remote name to push to (leave empty to auto-select "all" if defined, else "origin"):
SYNCALIBUR_REMOTE=""

# Timing & Native Event Watcher (`inotifywait` / `fswatch` hybrid with polling fallback):
SYNCALIBUR_USE_FS_EVENTS="true"
SYNCALIBUR_POLL_INTERVAL=3
SYNCALIBUR_DEBOUNCE_WAIT=5
SYNCALIBUR_MAX_DEBOUNCE=60

# Operating Architecture & Automation Persona:
# - "autopilot"    : Zero-Data-Loss continuous stream & flight recorder (default).
#                    5s settle debounce, AST Conventional Commit generation, Shannon Secret Shield,
#                    multi-remote push, and automatic Time Machine rollback checkpoints.
# - "manual"       : On-demand sync only. Daemon remains idle until you run `syncalibur save [msg]`
#                    or trigger immediate sync via TUI `[s]`.
# Note: You can override this per-repository by creating a `.syncalibur` file in the repo root!
SYNCALIBUR_MODE="autopilot"

# Fine-grained Cadence & History Hygiene:
# - SYNCALIBUR_BURST_COOLDOWN : Quiescent settle window (seconds) after file saves before committing (default: 5).
# - SYNCALIBUR_TIDY_THRESHOLD  : Minimum unpushed commits required to trigger auto-squash (default: 999).
# - SYNCALIBUR_AUTO_TIDY      : Enable automatic Conventional Commit squashing upon burst quiescence (default: false).
# - SYNCALIBUR_AUTO_PR        : "false" (default: push directly to branch; manual PRs via `syncalibur pr`).
SYNCALIBUR_BURST_COOLDOWN=5
SYNCALIBUR_TIDY_THRESHOLD=999
SYNCALIBUR_AUTO_TIDY="false"
SYNCALIBUR_AUTO_PR="false"

# Safety Shield:
SYNCALIBUR_MAX_FILE_SIZE_MB=50
SYNCALIBUR_SENSITIVE_PATTERNS=".env .env.* *.tfstate *.tfstate.* *.tfvars *.tfvars.json credentials.json client_secret*.json service-account*.json service_account*.json *serviceaccount*.json azureProfile.json *.pem *.key *.p12 *.pfx *.pkcs12 *.jks *.keystore id_rsa* id_ecdsa* id_ed25519* id_dsa* *.asc secring.gpg *.kdbx kubeconfig *.kubeconfig *.ovpn *.tblk auth.json .netrc .npmrc .pypirc *.htpasswd *.dump *.rdb *.bak *.backup"
SYNCALIBUR_BINARY_PATTERNS="*.iso *.img *.vmdk *.qcow2 *.tar *.gz *.tgz *.bz2 *.xz *.zip *.7z *.rar *.jar *.war *.ear *.exe *.dll *.so *.dylib *.bin *.o *.a *.pyc *.pyo *.class *.parquet *.avro *.db *.sqlite *.sqlite3"
SYNCALIBUR_PROTECT_SYNTAX="true"
SYNCALIBUR_SECRET_SHIELD="true"
# SYNCALIBUR_DISABLE_SHIELDS="false" # Set "true" to bypass secret & syntax shields (or run 'syncalibur shield off' / press [x] in cockpit)

# Retry & Log rotation:
SYNCALIBUR_RETRY_BASE=30
SYNCALIBUR_RETRY_MAX=900
SYNCALIBUR_PUSH_TIMEOUT=120
SYNCALIBUR_LOG_MAX_KB=1024
